{
    "name": "red-hat-design-site",
    "version": "",
    "title": "Red Hat - Design Site",
    "description": "A showcase of Red Hat's creative experiences, using open source principles.",
    "homepage": "https://github.com/RedHat-UX/red-hat-design-site",
    "license": "ISC",
    "author": {
        "name": "Digital Experience",
        "company": "Red Hat, Inc.",
        "url": "https://design.redhat.com"
    },
    "contributors": [
        {
            "name": "Ocean Matthews",
            "email": "ocean@redhat.com"
        },
        {
            "name": "Ryan Altvater",
            "email": "raltvate@redhat.com"
        }
    ],
    "repository": {
        "type": "git",
        "url": "git@github.com:RedHat-UX/red-hat-design-site.git"
    },
    "scripts": {
        "build": "gulp build",
        "setup": "npm ci --ignore-scripts && npx --no-install allow-scripts run",
        "start": "gulp"
    },
    "dependencies": {
        "bootstrap": "4.6.1"
    },
    "devDependencies": {
        "@lavamoat/allow-scripts": "^2.5.1",
        "@lavamoat/preinstall-always-fail": "^1.0.3",
        "@rhdc-fed/red_hat_shared_libs": "^6.1.4",
        "browser-sync": "^3.0.4",
        "del": "6.1.1",
        "gulp": "^5.0.1",
        "gulp-autoprefixer": "8.0.0",
        "gulp-clean-css": "4.3.0",
        "gulp-file-include": "2.3.0",
        "gulp-flatten": "0.4.0",
        "gulp-group-css-media-queries": "^1.2.2",
        "gulp-header": "2.0.9",
        "gulp-notify": "^5.0.0",
        "gulp-plumber": "^1.2.1",
        "gulp-rename": "^2.1.0",
        "gulp-sass": "5.1.0",
        "gulp-strip-css-comments": "2.0.0",
        "gulp-strip-debug": "4.0.0",
        "gulp-uglify-es": "3.0.0",
        "path": "0.12.7",
        "sass": "^1.96.0",
        "semver": "^7.7.3"
    },
    "lavamoat": {
        "allowScripts": {
            "@lavamoat/preinstall-always-fail": false,
            "sass>@parcel/watcher": true
        }
    },
    "browserslist": [
        "last 2 versions",
        "not dead",
        "> 0.2%"
    ],
    "paths": {
        "docs": {
            "root": "docs/",
            "css": "docs/assets/css/",
            "img": "docs/assets/img/",
            "js": "docs/assets/js/"
        },
        "repo": {
            "root": "./"
        },
        "src": {
            "root": "src/",
            "scss": "src/assets/scss/",
            "img": "src/assets/img/",
            "js": "src/assets/js/"
        }
    }
}
